{
  "entities": {
    "users": {
      "title": "Users",
      "description": "CRM Users and Sellers",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "vendedor"] },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected", "suspended"] },
        "assignedSellerName": { "type": ["string", "null"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role", "status"]
    },
    "auditLogs": {
      "title": "Audit Logs",
      "description": "Audit trail of user access and actions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "category": { "type": "string", "enum": ["auth", "leads", "pool", "campaigns", "users", "export", "system"] },
        "action": { "type": "string" },
        "description": { "type": "string" },
        "details": { "type": "string" }
      },
      "required": ["id", "timestamp", "userId", "userEmail", "category", "action", "description"]
    },
    "campaigns": {
      "title": "Campaigns",
      "description": "Sales Campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "descripcion": { "type": "string" },
        "scriptTemplate": { "type": "string" },
        "creadoEn": { "type": "string" },
        "creadoPor": { "type": "string" }
      },
      "required": ["id", "nombre"]
    },
    "leads": {
      "title": "Leads",
      "description": "Sales Leads",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nombre": { "type": "string" },
        "apellido": { "type": "string" },
        "dni": { "type": "string" },
        "telefono": { "type": "string" },
        "ultimoPeriodoPagado": { "type": "string" },
        "campanaId": { "type": "string" },
        "campanaNombre": { "type": "string" },
        "vendedorId": { "type": ["string", "null"] },
        "vendedorNombre": { "type": ["string", "null"] },
        "estado": { "type": "string" },
        "creadoEn": { "type": "string" }
      },
      "required": ["id", "nombre", "apellido", "dni"]
    }
  }
}
